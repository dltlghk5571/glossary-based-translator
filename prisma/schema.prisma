// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Glossary {
  id          Int      @id @default(autoincrement())
  korean      String   @unique
  english     String
  description String?
  category    String?

  // Used by the translation pipeline's glossary matching/audit (glossary_manager.py):
  // type/status classify the entry, aliases lets alternate Korean surface forms match,
  // status="approved" is required for a term to be force-matched during translation.
  type        String   @default("General")
  aliases     String   @default("")
  usageNote   String   @default("")
  status      String   @default("approved")
  source      String   @default("user")
  lastContext String   @default("")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([korean])
  @@index([english])
  @@index([status])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("user") // "admin" | "user"
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monthlyTokenLimit    Int      @default(100000)
  tokensUsedThisPeriod Int      @default(0)
  bonusTokens          Int      @default(0)
  periodStart          DateTime @default(now())

  topUpRequests TokenTopUpRequest[]
  translations  Translation[]

  @@index([role])
}

model Translation {
  id             Int      @id @default(autoincrement())
  sourceText     String
  translatedText String
  status         String   @default("draft")

  // Audit trail for the backoffice: what a translation run produced and cost.
  warnings     Json? // string[] from the audit report (glossary violations, dropped dates/URLs/etc.)
  matchedTerms Json? // [{ ko_term, en_term }] glossary terms enforced in this run
  inputTokens  Int?
  outputTokens Int?

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history TranslationHistory[]

  @@index([userId])
}

model TranslationHistory {
  id            Int      @id @default(autoincrement())
  translationId Int
  beforeText    String?
  afterText     String
  createdAt     DateTime @default(now())

  translation Translation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@index([translationId])
}

model TokenTopUpRequest {
  id            Int       @id @default(autoincrement())
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String    @default("pending") // pending | approved | denied
  grantedTokens Int?
  note          String    @default("")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([userId])
  @@index([status])
}
