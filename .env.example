ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override which provider handles each pipeline step.
# Values: anthropic (default), openai, google
# TERM_EXTRACTION_PROVIDER=anthropic
# TRANSLATION_PROVIDER=anthropic
# REPAIR_PROVIDER=anthropic

# Backoffice web app (Vercel deployment)
# DATABASE_URL: pooled connection (app runtime, e.g. Neon's "-pooler" host)
# DATABASE_URL_UNPOOLED: direct connection (used for `prisma migrate` via prisma.config.ts directUrl)
DATABASE_URL=postgres://user:password@host-pooler/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require
ADMIN_PASSWORD=change_me
