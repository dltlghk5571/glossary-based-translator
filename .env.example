ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override which provider handles each pipeline step.
# Values: anthropic (default), openai, google
# TERM_EXTRACTION_PROVIDER=anthropic
# TRANSLATION_PROVIDER=anthropic
# REPAIR_PROVIDER=anthropic

# Backoffice web app (Vercel deployment)
# DATABASE_URL: pooled connection (app runtime, e.g. Neon's "-pooler" host)
# DATABASE_URL_UNPOOLED: direct connection (used for `prisma migrate` via prisma.config.ts directUrl)
DATABASE_URL=postgres://user:password@host-pooler/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@host/dbname?sslmode=require

# `npm run test:integration` only -- a SEPARATE database (e.g. a dedicated
# Neon branch), never DATABASE_URL. It spins up a real `next dev` server and
# writes/deletes real rows over HTTP; pointing it at dev/prod would be
# destructive. See README.md "Tests".
TEST_DATABASE_URL=postgres://user:password@test-host/test-dbname?sslmode=require

# Signs the login session cookie (lib/auth.ts + api/index.py). Any change
# invalidates all existing sessions. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change_me

# Password for the seeded bootstrap admin account (username: admin) -- see
# `npx tsx scripts/seed-admin.ts`. Not read at runtime after seeding; further
# accounts are created from the /admin page.
ADMIN_PASSWORD=change_me
